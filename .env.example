# Backend (.env in backend/)
PORT=10000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Optional bearer token for administrative requests; catalog writes remain disabled.
ADMIN_API_TOKEN=

# Frontend (.env in frontend/)
# Empty = bundled read-only catalog, available offline.
# To use the backend instead: VITE_API_BASE_URL=/api (Vite proxies to localhost:10000).
VITE_API_BASE_URL=
